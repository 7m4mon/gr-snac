- name: acquisition
  id: epy_block
  parameters:
    _source_code: "\"\"\"Finite capture buffer and protocol-specific sync extraction\
      \ for the GRC.\"\"\"\nimport json\nfrom pathlib import Path\nimport numpy as\
      \ np\nfrom gnuradio import gr\n\n\nclass blk(gr.basic_block):\n    def __init__(self,\
      \ sample_count=1024, frame_count=1, acquire_fn=None, status_path='', validation_error=''):\n\
      \        gr.basic_block.__init__(self, name='Finite Capture Sync / 4-level Decisions',\n\
      \                                in_sig=[np.float32], out_sig=[np.uint8])\n\
      \        if validation_error:\n            raise ValueError(validation_error)\n\
      \        self.sample_count, self.frame_count = int(sample_count), int(frame_count)\n\
      \        if self.sample_count < 1 or self.frame_count < 1:\n            raise\
      \ ValueError('Positive finite capture and frame counts required')\n        self.acquire_fn,\
      \ self.status_path = acquire_fn, status_path\n        self.buffer = np.empty(self.sample_count,\
      \ dtype=np.float32)\n        self.received = self.offset = 0\n        self.bits\
      \ = None\n        self.error = None\n        self.status = {}\n\n    def forecast(self,\
      \ noutput_items, ninputs):\n        return [0 if self.bits is not None or self.error\
      \ is not None else 1]\n\n    def general_work(self, input_items, output_items):\n\
      \        if self.error is not None:\n            return -1\n        if self.bits\
      \ is None:\n            n = min(len(input_items[0]), self.sample_count-self.received)\n\
      \            self.buffer[self.received:self.received+n] = input_items[0][:n]\n\
      \            self.received += n\n            self.consume(0, n)\n          \
      \  if self.received < self.sample_count:\n                return 0\n       \
      \     try:\n                self.bits, self.status = self.acquire_fn(self.buffer,\
      \ self.frame_count)\n                self.status.update(error=None, captured_samples=self.received)\n\
      \            except Exception as exc:\n                self.error = exc\n  \
      \              self.status = dict(error=str(exc), captured_samples=self.received)\n\
      \            self.buffer = None\n            if self.status_path:\n        \
      \        Path(self.status_path).write_text(json.dumps(self.status, indent=2)+'\\\
      n')\n            if self.error is not None:\n                return -1\n   \
      \     n = min(len(output_items[0]), len(self.bits)-self.offset)\n        if\
      \ n == 0:\n            return -1\n        output_items[0][:n] = self.bits[self.offset:self.offset+n]\n\
      \        self.offset += n\n        return n\n"
    acquire_fn: rx_support.acquire
    affinity: ''
    alias: ''
    comment: ''
    frame_count: capture['frames']
    maxoutbuf: '0'
    minoutbuf: '0'
    sample_count: capture['iq_samples'] + 320
    status_path: wav_path + '.sync.json'
    validation_error: capture['validation_error']
  states:
    _io_cache: ('Finite Capture Sync / 4-level Decisions', 'blk', [('sample_count',
      '1024'), ('frame_count', '1'), ('acquire_fn', 'None'), ('status_path', "''"),
      ('validation_error', "''")], [('0', 'float', 1)], [('0', 'byte', 1)], '', ['acquire_fn',
      'frame_count', 'sample_count', 'status_path'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [848, 148.0]
    rotation: 0
    state: enabled
