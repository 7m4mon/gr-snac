options:
  parameters:
    author: 7M4MON
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: Standard GNU Radio CPM/FEC; edit variables and restart.
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: three_carriers
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: run
    sizing_mode: fixed
    thread_safe_setters: ''
    title: 'Gaussian 4CPFSK: three carriers'
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 8
    rotation: 0
    state: enabled
blocks:
- name: symbol_rate
  id: variable
  parameters:
    value: '1312.5'
  states:
    coordinate:
    - 16
    - 16
    rotation: 0
    state: enabled
    bus_sink: false
    bus_source: false
    bus_structure: null
- name: samples_per_symbol
  id: variable
  parameters:
    value: '32'
  states:
    coordinate:
    - 256
    - 16
    rotation: 0
    state: enabled
    bus_sink: false
    bus_source: false
    bus_structure: null
- name: sample_rate
  id: variable
  parameters:
    value: symbol_rate * samples_per_symbol
  states:
    coordinate:
    - 496
    - 16
    rotation: 0
    state: enabled
    bus_sink: false
    bus_source: false
    bus_structure: null
- name: modulation_index_h
  id: variable
  parameters:
    value: '0.25'
  states:
    coordinate:
    - 736
    - 16
    rotation: 0
    state: enabled
    bus_sink: false
    bus_source: false
    bus_structure: null
- name: gaussian_bt
  id: variable
  parameters:
    value: '0.30'
  states:
    coordinate:
    - 976
    - 16
    rotation: 0
    state: enabled
    bus_sink: false
    bus_source: false
    bus_structure: null
- name: pulse_length
  id: variable
  parameters:
    value: '4'
  states:
    coordinate:
    - 16
    - 106
    rotation: 0
    state: enabled
    bus_sink: false
    bus_source: false
    bus_structure: null
- name: channel_spacing
  id: variable
  parameters:
    value: '2500'
  states:
    coordinate:
    - 256
    - 106
    rotation: 0
    state: enabled
    bus_sink: false
    bus_source: false
    bus_structure: null
- name: seed
  id: variable
  parameters:
    value: '12345'
  states:
    coordinate:
    - 496
    - 106
    rotation: 0
    state: enabled
    bus_sink: false
    bus_source: false
    bus_structure: null
- name: random_symbols
  id: variable
  parameters:
    value: '262144'
  states:
    coordinate:
    - 736
    - 106
    rotation: 0
    state: enabled
    bus_sink: false
    bus_source: false
    bus_structure: null
- name: duration_seconds
  id: variable
  parameters:
    value: '60'
  states:
    coordinate:
    - 976
    - 106
    rotation: 0
    state: enabled
    bus_sink: false
    bus_source: false
    bus_structure: null
- name: iq_path
  id: variable
  parameters:
    value: '''three_carriers.cf32'''
  states:
    coordinate:
    - 16
    - 196
    rotation: 0
    state: enabled
    bus_sink: false
    bus_source: false
    bus_structure: null
- name: numpy_import
  id: import
  parameters:
    imports: import numpy as np
  states:
    coordinate:
    - 16
    - 280
    rotation: 0
    state: enabled
    bus_sink: false
    bus_source: false
    bus_structure: null
- name: window_size
  id: snippet
  parameters:
    section: main_after_init
    priority: '0'
    code: self.resize(1200, 900)
  states:
    coordinate:
    - 320
    - 280
    rotation: 0
    state: enabled
    bus_sink: false
    bus_source: false
    bus_structure: null
- name: source_0
  id: blocks_vector_source_x
  parameters:
    type: byte
    vector: np.random.default_rng(seed + 0).integers(0, 4, random_symbols, dtype=np.uint8).tolist()
    tags: '[]'
    repeat: 'True'
    vlen: '1'
  states:
    coordinate:
    - 16
    - 380
    rotation: 0
    state: enabled
    bus_sink: false
    bus_source: false
    bus_structure: null
- name: gray_0
  id: digital_map_bb
  parameters:
    map: '[253, 255, 3, 1]'
  states:
    coordinate:
    - 320
    - 380
    rotation: 0
    state: enabled
    bus_sink: false
    bus_source: false
    bus_structure: null
- name: cpm_0
  id: digital_cpmmod_bc
  parameters:
    type: analog.cpm.GAUSSIAN
    mod_index: modulation_index_h
    samples_per_symbol: samples_per_symbol
    L: pulse_length
    beta: gaussian_bt
  states:
    coordinate:
    - 520
    - 380
    rotation: 0
    state: enabled
    bus_sink: false
    bus_source: false
    bus_structure: null
- name: osc_0
  id: analog_sig_source_x
  parameters:
    type: complex
    samp_rate: sample_rate
    waveform: analog.GR_COS_WAVE
    freq: (0 - 1) * channel_spacing
    amp: '1'
    offset: '0'
    phase: '0'
  states:
    coordinate:
    - 520
    - 470
    rotation: 0
    state: enabled
    bus_sink: false
    bus_source: false
    bus_structure: null
- name: shift_0
  id: blocks_multiply_xx
  parameters:
    type: complex
    num_inputs: '2'
    vlen: '1'
  states:
    coordinate:
    - 790
    - 380
    rotation: 0
    state: enabled
    bus_sink: false
    bus_source: false
    bus_structure: null
- name: source_1
  id: blocks_vector_source_x
  parameters:
    type: byte
    vector: np.random.default_rng(seed + 1).integers(0, 4, random_symbols, dtype=np.uint8).tolist()
    tags: '[]'
    repeat: 'True'
    vlen: '1'
  states:
    coordinate:
    - 16
    - 570
    rotation: 0
    state: enabled
    bus_sink: false
    bus_source: false
    bus_structure: null
- name: gray_1
  id: digital_map_bb
  parameters:
    map: '[253, 255, 3, 1]'
  states:
    coordinate:
    - 320
    - 570
    rotation: 0
    state: enabled
    bus_sink: false
    bus_source: false
    bus_structure: null
- name: cpm_1
  id: digital_cpmmod_bc
  parameters:
    type: analog.cpm.GAUSSIAN
    mod_index: modulation_index_h
    samples_per_symbol: samples_per_symbol
    L: pulse_length
    beta: gaussian_bt
  states:
    coordinate:
    - 520
    - 570
    rotation: 0
    state: enabled
    bus_sink: false
    bus_source: false
    bus_structure: null
- name: osc_1
  id: analog_sig_source_x
  parameters:
    type: complex
    samp_rate: sample_rate
    waveform: analog.GR_COS_WAVE
    freq: (1 - 1) * channel_spacing
    amp: '1'
    offset: '0'
    phase: '0'
  states:
    coordinate:
    - 520
    - 660
    rotation: 0
    state: enabled
    bus_sink: false
    bus_source: false
    bus_structure: null
- name: shift_1
  id: blocks_multiply_xx
  parameters:
    type: complex
    num_inputs: '2'
    vlen: '1'
  states:
    coordinate:
    - 790
    - 570
    rotation: 0
    state: enabled
    bus_sink: false
    bus_source: false
    bus_structure: null
- name: source_2
  id: blocks_vector_source_x
  parameters:
    type: byte
    vector: np.random.default_rng(seed + 2).integers(0, 4, random_symbols, dtype=np.uint8).tolist()
    tags: '[]'
    repeat: 'True'
    vlen: '1'
  states:
    coordinate:
    - 16
    - 760
    rotation: 0
    state: enabled
    bus_sink: false
    bus_source: false
    bus_structure: null
- name: gray_2
  id: digital_map_bb
  parameters:
    map: '[253, 255, 3, 1]'
  states:
    coordinate:
    - 320
    - 760
    rotation: 0
    state: enabled
    bus_sink: false
    bus_source: false
    bus_structure: null
- name: cpm_2
  id: digital_cpmmod_bc
  parameters:
    type: analog.cpm.GAUSSIAN
    mod_index: modulation_index_h
    samples_per_symbol: samples_per_symbol
    L: pulse_length
    beta: gaussian_bt
  states:
    coordinate:
    - 520
    - 760
    rotation: 0
    state: enabled
    bus_sink: false
    bus_source: false
    bus_structure: null
- name: osc_2
  id: analog_sig_source_x
  parameters:
    type: complex
    samp_rate: sample_rate
    waveform: analog.GR_COS_WAVE
    freq: (2 - 1) * channel_spacing
    amp: '1'
    offset: '0'
    phase: '0'
  states:
    coordinate:
    - 520
    - 850
    rotation: 0
    state: enabled
    bus_sink: false
    bus_source: false
    bus_structure: null
- name: shift_2
  id: blocks_multiply_xx
  parameters:
    type: complex
    num_inputs: '2'
    vlen: '1'
  states:
    coordinate:
    - 790
    - 760
    rotation: 0
    state: enabled
    bus_sink: false
    bus_source: false
    bus_structure: null
- name: sum_carriers
  id: blocks_add_xx
  parameters:
    type: complex
    num_inputs: '3'
    vlen: '1'
  states:
    coordinate:
    - 1000
    - 520
    rotation: 0
    state: enabled
    bus_sink: false
    bus_source: false
    bus_structure: null
- name: capture_length
  id: blocks_head
  parameters:
    type: complex
    num_items: int(duration_seconds * sample_rate)
    vlen: '1'
  states:
    coordinate:
    - 1220
    - 380
    rotation: 0
    state: enabled
    bus_sink: false
    bus_source: false
    bus_structure: null
- name: throttle
  id: blocks_throttle
  parameters:
    type: complex
    samples_per_second: sample_rate
    vlen: '1'
    ignoretag: 'True'
  states:
    coordinate:
    - 1440
    - 380
    rotation: 0
    state: enabled
    bus_sink: false
    bus_source: false
    bus_structure: null
- name: frequency
  id: qtgui_freq_sink_x
  parameters:
    type: complex
    name: Spectrum (use mouse zoom for +/-5 kHz)
    fftsize: '8192'
    freqhalf: 'True'
    wintype: window.WIN_BLACKMAN_hARRIS
    norm_window: 'True'
    fc: '0'
    bw: sample_rate
    grid: 'True'
