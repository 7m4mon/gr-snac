    - 1670
    - 380
    rotation: 0
    state: enabled
    bus_sink: false
    bus_source: false
    bus_structure: null
- name: waterfall
  id: qtgui_waterfall_sink_x
  parameters:
    type: complex
    name: Gaussian 4CPFSK
    fftsize: '8192'
    freqhalf: 'True'
    wintype: window.WIN_BLACKMAN_hARRIS
    fc: '0'
    bw: sample_rate
    int_min: '-140'
    int_max: '10'
    grid: 'False'
    nconnections: '1'
    update_time: '0.10'
    gui_hint: 1,0,1,1
    showports: 'False'
    legend: 'True'
