options:
  parameters:
    author: ''
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: ''
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: no_gui
    hier_block_src_path: '.:'
    id: snac_loopback
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: run
    sizing_mode: fixed
    thread_safe_setters: ''
    title: SNAC 24k WAV Loopback
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: input_path
  id: variable
  parameters:
    comment: ''
    value: '''VOICEACTRESS100_001_001.wav'''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [240, 20.0]
    rotation: 0
    state: enabled
- name: output_path
  id: variable
  parameters:
    comment: ''
    value: '''reconstructed1.wav'''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [432, 20.0]
    rotation: 0
    state: enabled
- name: sample_count
  id: variable
  parameters:
    comment: ''
    value: wave.open(input_path, 'rb').getnframes()
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [592, 20.0]
    rotation: 0
    state: enabled
- name: token_path
  id: variable
  parameters:
    comment: ''
    value: '''encoded.snac'''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [240, 92.0]
    rotation: 0
    state: enabled
- name: decoder
  id: snac_decoder
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    context_frames: '2'
    device: cpu
    maxoutbuf: '0'
    minoutbuf: '0'
    model: hubertsiuzdak/snac_24khz
    verbose: 'True'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [648, 244.0]
    rotation: 0
    state: enabled
- name: encoder
  id: snac_encoder
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    context_frames: '2'
    device: cpu
    maxoutbuf: '0'
    minoutbuf: '0'
    model: hubertsiuzdak/snac_24khz
    total_samples: sample_count
    verbose: 'True'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [264, 236.0]
    rotation: 0
    state: enabled
- name: sink
  id: blocks_wavfile_sink
  parameters:
    affinity: ''
    alias: ''
    append: 'False'
    bits_per_sample1: FORMAT_PCM_16
    bits_per_sample2: FORMAT_PCM_16
    bits_per_sample3: FORMAT_VORBIS
    bits_per_sample4: FORMAT_PCM_16
    comment: ''
    file: output_path
    format: FORMAT_WAV
    nchan: '1'
    samp_rate: '24000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [952, 236.0]
    rotation: 0
    state: enabled
- name: source
  id: blocks_wavfile_source
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    file: input_path
    maxoutbuf: '0'
    minoutbuf: '0'
    nchan: '1'
    repeat: 'False'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [72, 260.0]
    rotation: 0
    state: enabled
- name: token_file
  id: snac_token_file
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    filename: token_path
    maxoutbuf: '0'
    minoutbuf: '0'
    model: hubertsiuzdak/snac_24khz
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [512, 388.0]
    rotation: 0
    state: enabled
- name: wav_import
  id: import
  parameters:
    alias: ''
    comment: ''
    imports: import wave
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 116.0]
    rotation: 0
    state: enabled

connections:
- [decoder, '0', sink, '0']
- [encoder, codes, token_file, codes]
- [source, '0', encoder, '0']
- [token_file, codes, decoder, codes]

metadata:
  file_format: 1
